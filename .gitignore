# ---------------------------------------------------------------
# Milk Bill Management - git ignore rules
# (android/ has its own .gitignore from Capacitor for Gradle files)
# ---------------------------------------------------------------

# --- Dependencies ---
node_modules/
.npm/
.pnpm-store/
.yarn/

# --- Build output ---
# www/ is generated by `npm run build:www`
www/
dist/
.dist/
build/
out/
coverage/
.cache/
*.tsbuildinfo

# --- Android signing: NEVER commit the key or its password ---
android-signing/
*.jks
*.keystore
*.p12
*.pem
keystore.properties
signing.properties

# --- Built apps ---
*.apk
*.aab
*.ap_
*.aar
*.idsig
output-metadata.json

# --- Android / Gradle (backup in case android/.gitignore is missing) ---
.gradle/
.kotlin/
.cxx/
.externalNativeBuild/
local.properties
captures/
*.hprof

# --- Environment / secrets ---
.env
.env.*
!.env.example
*.secret
secrets.json

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Editors / IDEs ---
.idea/
*.iml
.vscode/
*.swp
*.swo
*~
*.sublime-workspace

# --- AI tools ---
.claude/

# --- OS files ---
.DS_Store
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# --- Temp / backups ---
tmp/
temp/
*.tmp
*.bak
*.orig
